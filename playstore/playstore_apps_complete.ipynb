  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "clean_content_rating",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check Content Rating missing values\n",
    "print(\"Content Rating missing values:\", df_clean[\"Content Rating\"].isnull().sum())"
