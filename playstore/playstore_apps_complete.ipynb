  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "fill_content_rating",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fill the single missing Content Rating with mode\n",
    "df_clean[\"Content Rating\"] = df_clean[\"Content Rating\"].fillna(df_clean[\"Content Rating\"].mode()[0])\n",
    "print(\"Content Rating missing values after fill:\", df_clean[\"Content Rating\"].isnull().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "clean_current_ver",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check Current Ver and Android Ver missing values\n",
    "print(\"Current Ver missing:\", df_clean[\"Current Ver\"].isnull().sum())\n",
    "print(\"Android Ver missing:\", df_clean[\"Android Ver\"].isnull().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "fill_current_android",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Fill with 'Varies with device' which is the most common\n",
    "df_clean[\"Current Ver\"] = df_clean[\"Current Ver\"].fillna(\"Varies with device\")\n",
    "df_clean[\"Android Ver\"] = df_clean[\"Android Ver\"].fillna(\"Varies with device\")\n",
    "print(\"After filling - Current Ver missing:\", df_clean[\"Current Ver\"].isnull().sum())\n",
    "print(\"After filling - Android Ver missing:\", df_clean[\"Android Ver\"].isnull().sum())"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "clean_numeric_columns",
   "metadata": {},
   "source": [
    "### Clean Numeric Columns"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "convert_reviews",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert Reviews to numeric (currently stored as string)\n",
    "df_clean[\"Reviews\"] = df_clean[\"Reviews\"].astype(str).str.replace(\"[^0-9]\", \"\", regex=True)\n",
    "df_clean[\"Reviews\"] = pd.to_numeric(df_clean[\"Reviews\"], errors=\"coerce\")\n",
    "df_clean[\"Reviews\"] = df_clean[\"Reviews\"].fillna(0).astype(int)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "clean_size",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean Size column - convert to numeric (MB)\n",
    "def clean_size(size_str):\n",
    "    if pd.isna(size_str):\n",
    "        return 0\n",
    "    size_str = str(size_str).strip().upper()\n",
    "    if 'M' in size_str:\n",
    "        return float(size_str.replace('M', '').replace(',', ''))\n",
    "    elif 'K' in size_str:\n",
    "        return float(size_str.replace('K', '').replace(',', '')) / 1024\n",
    "    else:\n",
    "        return float(size_str.replace(',', '')) if size_str.replace(',', '').replace('.', '').isdigit() else 0\n",
    "\n",
    "df_clean[\"Size_MB\"] = df_clean[\"Size\"].apply(clean_size)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "clean_installs",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean Installs column - convert to numeric\n",
    "df_clean[\"Installs\"] = df_clean[\"Installs\"].astype(str).str.replace(\"[^0-9]\", \"\", regex=True)\n",
    "df_clean[\"Installs\"] = pd.to_numeric(df_clean[\"Installs\"], errors=\"coerce\")\n",
    "df_clean[\"Installs\"] = df_clean[\"Installs\"].fillna(0).astype(int)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "clean_price",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Clean Price column - convert to numeric\n",
    "df_clean[\"Price\"] = df_clean[\"Price\"].astype(str).str.replace(\"$\", \"\")\n",
    "df_clean[\"Price\"] = pd.to_numeric(df_clean[\"Price\"], errors=\"coerce\")\n",
    "df_clean[\"Price\"] = df_clean[\"Price\"].fillna(0)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "clean_date",
   "metadata": {},
   "source": [
    "### Clean Date Column"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "convert_last_updated",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert Last Updated to datetime\n",
    "df_clean[\"Last Updated\"] = pd.to_datetime(df_clean[\"Last Updated\"], errors=\"coerce\")\n",
    "print(\"Date conversion complete\")"
